<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.NanamyLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Disable default focus highlight for controllers -->
        <item name="android:defaultFocusHighlightEnabled">false</item>

        <!-- Prevent system from dimming the screen when mic or overlays are active -->
        <item name="android:backgroundDimEnabled">false</item>

        <!-- Background and Surface colors -->
        <item name="android:windowBackground">@color/black</item>
        <item name="colorSurface">#121212</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Customize your theme here. -->
    </style>
</resources>